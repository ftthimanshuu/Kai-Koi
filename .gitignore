# ─────────────────────────────────────────────
#  Kai Koi — .gitignore
# ─────────────────────────────────────────────

# ── Documents / Specs ─────────────────────────
*.pdf
!docs/*.pdf

# ── Dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build Outputs ─────────────────────────────
dist/
dist-ssr/
build/
out/
*.local

# ── Environment & Secrets ─────────────────────
.env
.env.*
!.env.example

# ── Java / Spring Boot ────────────────────────
target/
*.class
*.jar
!**/maven-wrapper.jar
*.war
*.ear
.mvn/timing

# ── Logs ──────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE & Editor ──────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS Files ──────────────────────────────────
.DS_Store
Thumbs.db

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript ────────────────────────────────
*.tsbuildinfo

# ── Misc ──────────────────────────────────────
.cache/
.parcel-cache/
