# ==========================================
# Kai Koi — Environment Configuration (.env)
# ==========================================

# ── Database (PostgreSQL) ─────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/kaikoi_db
DATABASE_USERNAME=kaikoi
DATABASE_PASSWORD=kaikoisecret

# ── Cache & Distributed Locks (Redis) ─────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Firebase Authentication ───────────────
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ── Razorpay Payment Gateway (Test Mode) ──
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Booking Configuration ─────────────────
BOOKING_HOLD_DURATION_MINUTES=10
