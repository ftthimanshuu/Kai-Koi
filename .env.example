# ==========================================
# Kai Koi — Environment Configuration (.env)
# ==========================================

# ── Database (Supabase PostgreSQL / Local) ───────────────
# Local Docker:
DATABASE_URL=jdbc:postgresql://localhost:5432/kaikoi_db
DATABASE_USERNAME=kaikoi
DATABASE_PASSWORD=kaikoisecret
# Supabase Cloud:
# DATABASE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_supabase_db_password

# ── Cache & Distributed Locks (Redis) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Supabase Authentication (JWT) ────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── Razorpay Payment Gateway (Test Mode) ─────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Booking Configuration ────────────────────────────────
BOOKING_HOLD_DURATION_MINUTES=10
